{
 "experiment": "cif.experiments.e2_benchmark",
 "inputs": {
  "eligibility_test": "configs/E2/pilot/eligibility_test.json",
  "orlib": "data/raw/orlib/provenance.json",
  "tuned": "configs/E2/pilot/tuned.json"
 },
 "launch": {
  "jobs": 16,
  "shards": 256,
  "timing": true
 },
 "mode": "full",
 "name": "bench_orlib",
 "params": {
  "budget_s": 60.0,
  "fixed": {
   "orlib_dir": "data/raw/orlib",
   "orlib_k": 10,
   "orlib_m": 25,
   "orlib_w_max": 1.0,
   "orlib_w_min": 0.01
  },
  "instances": [
   {
    "cell": "C5",
    "config_size": [
     {
      "max_n": 100,
      "size": 100
     },
     {
      "size": 200
     }
    ],
    "eligible": {
     "cell": "C5",
     "report": "eligibility_test"
    },
    "family": "orlib",
    "lam_indices": 25,
    "ports": [
     1,
     2,
     3,
     4,
     5
    ]
   }
  ],
  "methods": {
   "roles": [
    "exact_rep",
    "qubo_rep",
    "ls",
    "sa",
    "tabu",
    "swap_sa"
   ],
   "source": "tuned"
  },
  "overrun_tol_rel": 0.05,
  "seed_role": "test",
  "skip_nonbinding": true,
  "solver": {
   "abs_gap_rel": 1e-06,
   "abs_gap_safety": 0.5,
   "mip_gap": 1e-06,
   "trajectory_tol": 1e-09
  },
  "solver_seeds": {
   "exact": [
    20000,
    20001,
    20002
   ],
   "heuristic": [
    20000,
    20001,
    20002,
    20003,
    20004,
    20005,
    20006,
    20007,
    20008,
    20009
   ]
  },
  "stage": "bench",
  "warm_up": true
 },
 "stream": "E2"
}